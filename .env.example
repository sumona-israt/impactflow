# Variables consumed by docker-compose.yml itself (service ports, Postgres
# bootstrap credentials). Application-level config lives in backend/.env and
# frontend/.env — copy each *.env.example alongside this one.
#
# Copy this file to `.env` at the repo root before running `docker compose up`.

APP_PORT=80

DB_DATABASE=impactflow
DB_USERNAME=impactflow
DB_PASSWORD=change-me
